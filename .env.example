# Database
DATABASE_URL=postgresql+psycopg://blog_user:blog_pass@localhost/blog

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Uploads
MAX_UPLOAD_SIZE_BYTES=5242880



# S3 / Object Storage (AWS S3 or MinIO)
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example (set in Railway dashboard, not here)
# CORS_ORIGINS=https://your-app.pages.dev,https://your-custom-domain.com